{
  "name": "Price Bridge Extension",
  "description": "This extension allows you find the best prices.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_title": "Open the popup"
  },
  "icons": {
    "16": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:5050/*"],
  "background": {
    "service_worker": "static/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ozon.ru/*"],
      "js": ["./static/js/content.js"]
    }
  ]
}
